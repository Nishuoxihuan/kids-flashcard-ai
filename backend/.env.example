# ============ 中转站配置（推荐） ============
# 如果你使用中转站，请配置以下参数
# 如果不使用，保持默认（官方 API）即可

# OpenAI 配置
OPENAI_API_KEY=sk-你的中转站 API Key
OPENAI_BASE_URL=https://api.xinyuanai666.com/v1  # 中转站地址
OPENAI_MODEL=dall-e-3  # 中转站的模型名称

# Anthropic (Claude) 配置
ANTHROPIC_API_KEY=sk-你的中转站 API Key
ANTHROPIC_BASE_URL=https://api.xinyuanai666.com  # 中转站地址
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # 中转站的模型名称

# ============ 官方 API 配置（备选） ============
# 如果你使用官方 API，取消下面的注释并填写

# OPENAI_API_KEY=sk-你的官方 OpenAI Key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=dall-e-3

# ANTHROPIC_API_KEY=sk-ant-你的官方 Anthropic Key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 服务器端口
PORT=3000

# 环境设置
NODE_ENV=development
